#!/usr/bin/env python3
"""把 ARM 侧 radar-export 的静态 JSON 同步到 dApp 本地 data/ 目录。

边界（2026-11-18 lead 8e07 / 450d）：
- server 只做 ARM 只读导出，home 只做「公开上层」。本脚本只读复制，不登录 ARM 之外的账号、
  不建公开仓库、不部署、不对外发布、不碰交易/资金、不改导出源。
- 默认源为本机已下载的样例；正式源走 SSH 从 ARM /home/ubuntu/radar-export/ 只读拉取，
  目标目录固定为本仓库 data/。

用法：
  python3 tools/sync_radar_export.py --check
  python3 tools/sync_radar_export.py --from-local data-latest.sample.json
  python3 tools/sync_radar_export.py --from-arm      # 需要本机 SSH key，默认路径
"""
import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DATA = ROOT / "data"
LATEST = DATA / "latest.json"
SSH_KEY = Path.home() / "桌面/ssh-key-2026-06-07arm.key"
HOST = "ubuntu@100.77.74.3"
REMOTE = "/home/ubuntu/radar-export/latest.json"


def validate(doc):
    """返回 (ok, summary)。只做结构校验，不解释数据含义。"""
    if not isinstance(doc, dict):
        return False, "顶层不是 dict"
    if not isinstance(doc.get("date"), str) or not doc["date"]:
        return False, "缺 date"
    if not isinstance(doc.get("generated_at"), str) or not doc["generated_at"]:
        return False, "缺 generated_at"
    sec = doc.get("sections")
    if not isinstance(sec, dict):
        return False, "缺 sections"
    out = []
    for name in ("stocks", "meme", "x"):
        s = sec.get(name)
        if not isinstance(s, dict) or not isinstance(s.get("items"), list):
            return False, "section %s 缺 items 列表" % name
        out.append("%s=%d" % (name, len(s["items"])))
    return True, "date=%s generated_at=%s %s" % (doc["date"], doc["generated_at"], " ".join(out))


def load_doc(args):
    if args.from_local:
        return Path(args.from_local).read_text(encoding="utf-8"), "local:" + str(args.from_local)
    if args.from_arm:
        if not SSH_KEY.exists():
            raise SystemExit("缺 SSH key：%s" % SSH_KEY)
        cmd = ["ssh", "-i", str(SSH_KEY), "-o", "ConnectTimeout=15", HOST, "cat " + REMOTE]
        p = subprocess.run(cmd, capture_output=True, timeout=60)
        if p.returncode != 0:
            raise SystemExit("SSH 读取失败：%s" % p.stderr.decode(errors="replace")[:200])
        return p.stdout.decode("utf-8"), "arm:" + REMOTE
    raise SystemExit("请指定 --from-local 或 --from-arm（或只用 --check）")


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--check", action="store_true", help="只校验当前 data/latest.json")
    ap.add_argument("--from-local", help="从本机 JSON 文件复制（样例/离线校验）")
    ap.add_argument("--from-arm", action="store_true", help="从 ARM 只读拉取 latest.json")
    a = ap.parse_args()

    if a.check:
        if not LATEST.exists():
            raise SystemExit("缺 %s" % LATEST)
        raw = LATEST.read_text(encoding="utf-8")
    else:
        raw, src = load_doc(a)
        try:
            doc = json.loads(raw)
        except Exception as e:
            raise SystemExit("JSON 解析失败：%s" % e)
        ok, summary = validate(doc)
        if not ok:
            raise SystemExit("结构校验失败：%s" % summary)
        # 原子替换：先写暂存再 os.replace，避免前端读到半截文件
        DATA.mkdir(parents=True, exist_ok=True)
        fd, tmp = tempfile.mkstemp(prefix=".latest-", dir=str(DATA))
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                f.write(raw)
                f.write("\n")
            os.replace(tmp, LATEST)
        except Exception:
            try:
                os.unlink(tmp)
            except OSError:
                pass
            raise
        print("已同步 %s → %s；%s" % (src, LATEST, summary))
        return 0

    try:
        ok, summary = validate(json.loads(raw))
    except Exception as e:
        raise SystemExit("JSON 解析失败：%s" % e)
    print("校验 %s：%s" % (LATEST, "OK" if ok else "FAIL"))
    print(summary)
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
