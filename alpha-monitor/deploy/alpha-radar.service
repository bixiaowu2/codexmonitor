[Unit]
Description=Alpha Futures Radar with Telegram delivery
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=alpha-radar
Group=alpha-radar
WorkingDirectory=/opt/alpha-radar
EnvironmentFile=/etc/alpha-radar.env
Environment=RADAR_DATA=/var/lib/alpha-radar
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/alpha-radar/cloud.py
Restart=always
RestartSec=30
TimeoutStopSec=40
UMask=0077
StateDirectory=alpha-radar
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
ReadWritePaths=/var/lib/alpha-radar
MemoryMax=768M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
