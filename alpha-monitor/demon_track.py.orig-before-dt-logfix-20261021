#!/usr/bin/env python3
"""妖币候选跟踪器(只读)。只跟踪 S 级(清洗Top10≥60%)命中币。

信号:
  B. 启动: 资金费率转负(<-0.1%) / 合约持仓暴增(+30%) / 突破7日高点 → 推;
  A. 回撤: 从3日高点回撤≥25%(瀑布预警, 阈值放宽以拿住涨幅) → 推;
  T. 分批止盈: 较Alpha上线首收价 ≥3x / ≥10x → 推第一/第二档止盈;
  每天一次 S 级状态汇总。

较首收价的倍数用于止盈; 用首收价(而非当前成本)因为它是公开可复现的基准。
"""
from __future__ import annotations
import sys, json, time, os, concurrent.futures, types
from pathlib import Path
sys.path.insert(0, '/opt/alpha-radar')
import dingtalk
from radar import PublicAPI, FUTURES, num

DATA = Path('/var/lib/demon-radar')
MATCHES = DATA / 'matches.json'
STATE = DATA / 'track_state.json'
DRAWDOWN_PCT = 0.25
DRAWDOWN_STEP = 0.10          # 回撤再扩大 10 个百分点才追发
DRAWDOWN_COOLDOWN = 6 * 3600  # 或至少间隔 6 小时
FR_NEG = -0.001
OI_SURGE = 1.30
TP1 = 3.0   # 第一档止盈倍数
TP2 = 10.0  # 第二档止盈倍数
PRICE_CACHE = DATA / 'price_cache.json'

# ---------------------------------------------------------------- 结果表
# 2026-10-20 加: 让 Alpha 主选币也有可回测的历史(此前只存在滚动状态文件里)
import sqlite3
TRACK_DB = DATA / 'alpha_tracks.sqlite'
MAX_DAYS = 7            # 超过 7 天没更新就算收盘
RESET_AFTER = 7 * 86400  # 同一标的间隔超过 7 天再次入选, 算新一批


def _init_tracks():
    db = sqlite3.connect(str(TRACK_DB), timeout=20)
    db.execute('PRAGMA journal_mode=WAL')
    db.execute('PRAGMA busy_timeout=5000')
    db.execute('''CREATE TABLE IF NOT EXISTS alpha_tracks(
        key TEXT PRIMARY KEY,
        symbol TEXT, address TEXT, futures TEXT,
        first_seen REAL, last_seen REAL,
        entry REAL, last REAL, peak REAL, trough REAL, max_dd REAL,
        tp1 INTEGER DEFAULT 0, tp2 INTEGER DEFAULT 0,
        updates INTEGER DEFAULT 0,
        closed INTEGER DEFAULT 0, final_mult REAL)''')
    db.execute('CREATE INDEX IF NOT EXISTS by_sym ON alpha_tracks(symbol, first_seen)')
    db.commit()
    return db


def _record_track(db, sym, address, futs, price, tp1, tp2, now):
    """把这次观察写进结果表。price 是 demon_track 的 {'first','last','peak_3d'}。"""
    if not price:
        return
    first, last, peak3 = price.get('first'), price.get('last'), price.get('peak_3d')
    if not first or first <= 0 or not last or last <= 0:
        return
    row = db.execute('SELECT * FROM alpha_tracks WHERE symbol=? ORDER BY first_seen DESC LIMIT 1',
                     (sym,)).fetchone()
    if row is None or (now - (row[5] or 0)) > RESET_AFTER:
        # 首次入选, 或间隔太久算新一批
        key = f'{sym}:{time.strftime("%Y%m%d", time.gmtime(now))}'
        db.execute('''INSERT OR REPLACE INTO alpha_tracks
            (key,symbol,address,futures,first_seen,last_seen,entry,last,peak,trough,max_dd,
             tp1,tp2,updates,closed,final_mult)
            VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,0,NULL)''',
            # entry 用 last(入选时的现价) —— 前瞻, 不是 first(3天前收盘, 回溯)
            (key, sym, address, futs, now, now, last, last, last, last,
             0.0, int(bool(tp1)), int(bool(tp2)), 1))
    else:
        # 更新既有行
        e = row[6] or last                      # entry 保持首次入选价不变
        pk = max(row[8] or e, peak3 or last, last)
        tr = min(row[9] or e, last)
        db.execute('''UPDATE alpha_tracks
            SET last_seen=?, last=?, peak=?, trough=?, max_dd=?,
                tp1=MAX(tp1,?), tp2=MAX(tp2,?), updates=updates+1
            WHERE key=?''',
            (now, last, pk, tr, max(0.0, 1 - last / pk), int(bool(tp1)), int(bool(tp2)), row[0]))
    db.commit()


def _close_stale_tracks(db, now):
    """超过 MAX_DAYS 没更新的标记收盘, 记最终倍数。"""
    db.execute('''UPDATE alpha_tracks SET closed=1, final_mult=last/entry
                  WHERE closed=0 AND entry>0 AND last IS NOT NULL
                    AND last_seen < ?''', (now - MAX_DAYS * 86400,))
    db.commit()


def load_env():
    env = {}
    p = Path('/etc/alpha-radar.env')
    if p.exists():
        for line in p.read_text(encoding='utf-8').splitlines():
            line = line.strip()
            if line and not line.startswith('#') and '=' in line:
                k, v = line.split('=', 1)
                env[k.strip()] = v.strip()
    return env


def secret(env, name):
    p = env.get(name + '_FILE')
    return Path(p).read_text().strip() if p else env.get(name, '').strip()


def telegram_send(token, chat, text):
    import urllib.request
    body = json.dumps({'chat_id': chat, 'text': text, 'disable_web_page_preview': True}).encode()
    req = urllib.request.Request('https://api.telegram.org/bot' + token + '/sendMessage',
                                 data=body, headers={'Content-Type': 'application/json'})
    urllib.request.urlopen(req, timeout=15).read()


def dingtalk_send(env, text):
    if env.get('DEMON_DINGTALK_ENABLED', env.get('DINGTALK_ENABLED', 'false')).strip().lower() != 'true':
        return
    cfg = types.SimpleNamespace(
        ding_webhook=secret(env, 'DINGTALK_WEBHOOK'),
        ding_secret=secret(env, 'DINGTALK_SECRET'),
        ding_keyword=env.get('DINGTALK_KEYWORD', 'Alpha雷达').strip(),
    )
    if not cfg.ding_webhook:
        return
    dingtalk.send(cfg, text)


def fetch_price(api, futs):
    try:
        kl = api.get(FUTURES + '/fapi/v1/klines', {'symbol': futs, 'interval': '1d', 'limit': 200})
        if not isinstance(kl, list) or not kl:
            return None
        closes = [num(k[4]) for k in kl if isinstance(k, list) and len(k) >= 5 and num(k[4]) and num(k[4]) > 0]
        if not closes:
            return None
        # 3日高点改用小时线最高价: 原先用72个日收盘(实为72天高点), 盘中冲高回落检测严重滞后
        peak = max(closes[-3:])
        try:
            kh = api.get(FUTURES + '/fapi/v1/klines', {'symbol': futs, 'interval': '1h', 'limit': 72})
            if isinstance(kh, list) and kh:
                highs = [num(k[2]) for k in kh if isinstance(k, list) and len(k) >= 6 and num(k[2]) and num(k[2]) > 0]
                if highs:
                    peak = max(peak, max(highs))
        except Exception:
            pass
        return {'first': closes[0], 'last': closes[-1], 'peak_3d': peak}
    except Exception:
        return None


def fetch_oi(api, futs):
    try:
        oih = api.get(FUTURES + '/futures/data/openInterestHist', {'symbol': futs, 'period': '1d', 'limit': 2})
        if isinstance(oih, list) and oih:
            return num(oih[-1].get('sumOpenInterestValue'))
    except Exception:
        pass
    return None


def fetch_funding(api, futs):
    try:
        fr = api.get(FUTURES + '/fapi/v1/fundingRate', {'symbol': futs, 'limit': 5})
        if isinstance(fr, list) and fr:
            return [num(x.get('fundingRate')) for x in fr if isinstance(x, dict) and num(x.get('fundingRate')) is not None]
    except Exception:
        pass
    return []


def notify(env, token, chat, body):
    if token and chat:
        try:
            telegram_send(token, chat, body)
            print('telegram: sent')
        except Exception as e:
            print('telegram fail:', str(e)[:100])
    try:
        dingtalk_send(env, body)
        print('dingtalk: sent')
    except Exception as e:
        print('dingtalk fail:', str(e)[:100])


def main():
    env = load_env()
    token = secret(env, 'TELEGRAM_BOT_TOKEN')
    chat = secret(env, 'TELEGRAM_CHAT_ID')
    if not MATCHES.exists():
        print('无命中币, 跳过')
        return
    try:
        matches = json.loads(MATCHES.read_text(encoding='utf-8'))
    except Exception:
        print('命中文件损坏')
        return
    matches = [m for m in matches if isinstance(m, dict) and m.get('symbol')]
    # 只跟踪 S 级(高控盘)
    s_tier = [m for m in matches if m.get('tier') == 'S']
    if not s_tier:
        print('无 S 级命中币, 跳过')
        return

    try:
        tdb = _init_tracks()
        _close_stale_tracks(tdb, time.time())
    except Exception as _e:
        print(f'结果表初始化失败(不影响跟踪): {_e}')
        tdb = None

    state = {}
    if STATE.exists():
        try:
            state = json.loads(STATE.read_text(encoding='utf-8'))
        except Exception:
            state = {}
    drawn = set(state.get('drawn_symbols', []))
    drawn_dd = dict(state.get('drawn_dd', {}))
    drawn_ts = dict(state.get('drawn_ts', {}))
    fr_alerted = set(state.get('fr_alerted', []))
    oi_snap = state.get('oi_snap', {})
    tp_hit = set(state.get('tp_hit', []))

    api = PublicAPI('/var/lib/demon-radar/track-cache', ttl=300)
    alerts = []
    sq_events = []
    for m in s_tier:
        sym = m['symbol']
        futs = m.get('futures', sym + 'USDT')
        price = fetch_price(api, futs)
        if price:
            first, last, peak = price['first'], price['last'], price['peak_3d']
            # T. 分批止盈
            if first and first > 0:
                mult = last / first
                if mult >= TP2 and sym + ':tp2' not in tp_hit:
                    _msg = f"💰 第二档止盈 · {sym}\n较候选基准价(合约首日收盘) {first:.6g} 已涨 {mult:.1f}x (现价 {last:.6g})。\n建议再出 1/3 锁定利润, 剩 1/3 博更高。"
                    alerts.append(_msg)
                    sq_events.append({"kind": "止盈2", "symbol": sym, "futures": futs, "text": _msg, "ts": time.time(), "mult": mult, "price": last, "base": first, "address": m.get('address')})
                    tp_hit.add(sym + ':tp2')
                elif mult >= TP1 and sym + ':tp1' not in tp_hit:
                    _msg = f"💰 第一档止盈 · {sym}\n较候选基准价(合约首日收盘) {first:.6g} 已涨 {mult:.1f}x (现价 {last:.6g})。\n建议出 1/3 锁定利润, 剩 2/3 继续持有。"
                    alerts.append(_msg)
                    sq_events.append({"kind": "止盈1", "symbol": sym, "futures": futs, "text": _msg, "ts": time.time(), "mult": mult, "price": last, "base": first, "address": m.get('address')})
                    tp_hit.add(sym + ':tp1')
            # A. 回撤(瀑布预警, 25%)
            if peak and last:
                dd = (peak - last) / peak
                if dd >= DRAWDOWN_PCT:
                    _last_dd = drawn_dd.get(sym, 0.0)
                    _last_ts = drawn_ts.get(sym, 0.0)
                    _deepened = (dd - _last_dd) >= DRAWDOWN_STEP
                    _cooled = (time.time() - _last_ts) >= DRAWDOWN_COOLDOWN
                    if sym not in drawn or _deepened or _cooled:
                        _msg = f"⚠️ 回撤预警 · {sym}\n从3日高点 {peak:.6g} 回落 {dd*100:.1f}% 至 {last:.6g}。瀑布或已开始, 注意止损/止盈。"
                        alerts.append(_msg)
                        sq_events.append({"kind": "回撤", "symbol": sym, "futures": futs, "text": _msg, "ts": time.time(), "peak": peak, "last": last, "drop_pct": dd, "address": m.get('address')})
                        drawn.add(sym)
                        drawn_dd[sym] = dd
                        drawn_ts[sym] = time.time()
                else:
                    drawn.discard(sym)
                    drawn_dd.pop(sym, None)
        if tdb is not None and price:
            try:
                _record_track(tdb, sym, m.get('address'), futs, price,
                              sym + ':tp1' in tp_hit, sym + ':tp2' in tp_hit, time.time())
            except Exception:
                pass   # 记录失败不能影响跟踪与告警
        frs = fetch_funding(api, futs)
        if frs:
            cur = frs[-1]
            if cur is not None and cur < FR_NEG and sym not in fr_alerted:
                _msg = f"🚀 启动信号 · {sym}\n资金费率转负 {cur*100:.3f}%, 可能逼空拉升。"
                alerts.append(_msg)
                sq_events.append({"kind": "启动", "symbol": sym, "futures": futs, "text": _msg, "ts": time.time(), "rate": cur, "price": last, "address": m.get('address')})
                fr_alerted.add(sym)
        oi = fetch_oi(api, futs)
        prev = oi_snap.get(sym)
        if oi is not None:
            if prev and prev > 0 and oi > prev * OI_SURGE:
                _msg = f"📈 持仓异动 · {sym}\n合约持仓 {oi/1e6:.1f}M, 较前期 {prev/1e6:.1f}M 增 {oi/prev-1:+.1%}。"
                alerts.append(_msg)
                sq_events.append({"kind": "持仓", "symbol": sym, "futures": futs, "text": _msg, "ts": time.time(), "oi": oi, "prev": prev, "address": m.get('address')})
            oi_snap[sym] = oi

    # oi_snap 只保留本轮的 S 档 —— 否则掉档币的值永久残留，
    # 等它回到 S 档时会被当成「前期」比，误报「持仓异动」。
    _alive = {m['symbol'] for m in s_tier}
    oi_snap = {k: v for k, v in oi_snap.items() if k in _alive}
    state.update({'drawn_symbols': list(drawn), 'drawn_dd': drawn_dd, 'drawn_ts': drawn_ts, 'fr_alerted': list(fr_alerted), 'oi_snap': oi_snap, 'tp_hit': list(tp_hit), 'last_run': time.time()})
    STATE.write_text(json.dumps(state, ensure_ascii=False))
    if tdb is not None:
        try:
            tdb.close()
        except Exception:
            pass
    if sq_events:
        with (DATA / 'square_queue.jsonl').open('a', encoding='utf-8') as _qf:
            for _e in sq_events:
                _qf.write(json.dumps(_e, ensure_ascii=False) + '\n')

    if alerts:
        header = f"🎯 S级妖币跟踪 @ {time.strftime('%m-%d %H:%M UTC', time.gmtime())}\n当前S级: {', '.join(m['symbol'] for m in s_tier)}\n"
        body = header + '\n\n'.join(alerts)
        print(body)
        notify(env, token, chat, body)
    else:
        print(f'监控 {len(s_tier)} 个S级币, 无异动。')

    if time.time() - state.get('last_summary', 0) >= 24 * 3600:
        lines = [f'📊 S级妖币日更 @ {time.strftime("%m-%d %H:%M UTC", time.gmtime())}']
        for m in s_tier:
            sym = m['symbol']
            futs = m.get('futures', sym + 'USDT')
            price = fetch_price(api, futs)
            frs = fetch_funding(api, futs)
            fr = frs[-1] if frs else None
            oi = oi_snap.get(sym)
            px = price['last'] if price else None
            mult = (px / price['first']) if (price and price['first']) else None
            px_s = f'{px:.6g}' if px else '?'
            mult_s = f'{mult:.1f}x' if mult else '?'
            fr_s = f'{fr*100:.4f}%' if fr is not None else '?'
            oi_s = f'{oi/1e6:.1f}M' if oi else '?'
            lines.append(f"• {sym}: {px_s} ({mult_s}) 费率 {fr_s} 持仓 {oi_s}")
        notify(env, token, chat, '\n'.join(lines))
        state['last_summary'] = time.time()
        STATE.write_text(json.dumps(state, ensure_ascii=False))


if __name__ == '__main__':
    main()
