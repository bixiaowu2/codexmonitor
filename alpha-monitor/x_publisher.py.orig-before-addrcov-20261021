DRAFT_LOG = Path('/var/lib/x-publisher/drafts.jsonl')


def _draft_log(rec):
    """把推出去的草稿落盘。写失败不能影响发帖。"""
    try:
        DRAFT_LOG.parent.mkdir(parents=True, exist_ok=True)
        with DRAFT_LOG.open('a', encoding='utf-8') as f:
            f.write(json.dumps(rec, ensure_ascii=False) + '\n')
    except Exception as e:
        print(f"  [草稿日志] 写失败(不影响发帖): {type(e).__name__}")


def draft_today():
    """生成今日草稿包(妖币观察池 + 每日复盘)。

    「聪明钱扫货」已移出 —— 它的内容是 SOL/BSC 小币(钱包池), 属 meme 内容,
    现由 meme_publish 的草稿包发出。
    """
    drafts = []
    for fn in (compose_scan_alpha, compose_review):
        try:
            text = fn()
        except Exception:
            text = None
        if text:
            drafts.append(text)
    return drafts


def tg_send(text, chat=None):
    """推草稿到 Telegram(人工复制发X)。"""
    import urllib.request
    env = {}
    for line in Path("/etc/alpha-radar.env").read_text().splitlines():
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            k, v = line.split("=", 1)
            env[k.strip()] = v.strip()
    token = env.get("TELEGRAM_BOT_TOKEN", "")
    chat = chat or env.get("TELEGRAM_CHAT_ID", "")
    if not token or not chat:
        print("缺少 Telegram 配置")
        return False
    body = json.dumps({"chat_id": chat, "text": text, "disable_web_page_preview": True}).encode()
    req = urllib.request.Request("https://api.telegram.org/bot" + token + "/sendMessage",
                                 data=body, headers={"Content-Type": "application/json"})
    urllib.request.urlopen(req, timeout=15).read()
    return True


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--test', action='store_true')
    ap.add_argument('--scan', action='store_true')
    ap.add_argument('--review', action='store_true')
    ap.add_argument('--run', action='store_true')
    ap.add_argument('--draft', action='store_true', help='生成今日草稿推文, 推送Telegram(人工发X)')
    args = ap.parse_args()

    if args.test:
        text = ('Alpha雷达上线测试 ✅\n'
                '本号将日更: 币安Alpha妖币观察池(大户控盘筛选)/启动·回撤信号/每日复盘\n'
                '数据筛选, 不构成投资建议。')
        try:
            tid = post_tweet(text)
            print(f"测试帖已发 tweet_id={tid}")
        except Exception as e:
            print(f"测试失败: {type(e).__name__}: {str(e)[:200]}")
        return

    if args.scan:
        text = compose_scan_alpha()
        if text:
            enqueue(text, 'scan')
            print('筛选类内容已入队')
        else:
            print('无筛选内容')
        return
    if args.review:
        text = compose_review()
        if text:
            enqueue(text, 'review')
            print('复盘类内容已入队')
        else:
            print('无复盘内容')
        return
    if args.run:
        process_queue()
        return

    if args.draft:
        drafts = draft_today()
        if not drafts:
            print("今日无可发内容")
            return
        import sys as _s
        _s.path.insert(0, '/opt/alpha-radar')
        import post_style as ps
        ts = time.strftime("%m-%d %H:%M UTC", time.gmtime())
        sent = 0
        # 每栏一条消息(图 + 该栏全文) —— 与 meme 侧一致。
        # 原来发"1 条文字 + N 条纯图", 用户得自己把图和文字对上, 看起来像"没有图"。
        import sys as _s2
        _s2.path.insert(0, '/opt/content-push')
        try:
            import relay
        except Exception:
            relay = None
        for d in drafts:
            # 复盘类统一由内容 bot 发(群里只有一个发件人); 其余草稿走 Alpha bot
            is_review = '复盘' in d['label']
            _tag = '[复盘]' if is_review else '[Alpha]'
            parts = [f"📝 {_tag} {d['label']} @ {ts}",
                     "【主帖】\n" + d['main']]
            for i, t in enumerate(d.get('thread') or [], 1):
                parts.append(f"【跟帖{i}】\n" + t)
            text = "\n\n".join(parts)
            for w in ps.audit(d['main'], platform='x'):
                print(f"[风格告警·x · {d['label']}] {w}")
            for i, t in enumerate(d.get('thread') or [], 1):
                for w in ps.audit(t, platform='x'):
                    print(f"[风格告警·x · {d['label']} 跟帖{i}] {w}")
            chart = Path(d['chart']) if d.get('chart') else None
            _draft_log({'ts': time.time(),
                        'ts_human': time.strftime('%Y-%m-%d %H:%M UTC', time.gmtime()),
                        'label': d['label'],
                        'vid': d.get('vid'),
                        'thread_vid': d.get('thread_vid'),
                        'chart': d.get('chart'),
                        'main': d['main'],
                        'thread': d.get('thread') or []})
            if is_review and relay is not None:
                _photo = chart if (chart and chart.exists()) else None
                if relay.send(text, _photo):
                    print(f"  {d['label']}: 已推 Telegram(内容 bot"
                          + (f"，带图 {chart.name})" if _photo else "，纯文字)"))
                    sent += 1
                else:
                    print(f"  {d['label']}: 内容 bot 发送失败")
                continue
            _dc = _draft_chat()
            if chart and chart.exists() and tg_send_photo(chart, text, _dc):
                print(f"  {d['label']}: 已推 Telegram(带图 {chart.name})")
                sent += 1
            elif tg_send(text, _dc):
                print(f"  {d['label']}: 已推 Telegram(纯文字 —— 出图失败)")
                sent += 1
        print(f"草稿已推 Telegram({sent}/{len(drafts)} 栏, 每栏一条 图+全文, 可直接照着发X)")
        return

    print(__doc__)


if __name__ == '__main__':
    main()
