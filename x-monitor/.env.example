# Comma-separated X usernames, without @
X_ACCOUNTS=binancezh,cz_binance,heyibinance,binancewallet

# Target polling interval; end-to-end delivery latency must be measured
POLL_SECONDS=120
# Restart automatically if the browser loop makes no progress for this many seconds
WATCHDOG_SECONDS=900
MAX_ITEMS_PER_ACCOUNT=20

# On this Oracle host, normal Chromium under Xvfb works; headless Chromium gets HTTP 403.
HEADLESS=false
BROWSER_PROFILE_DIR=./browser-profile
STATE_FILE=./data/state.json
ROUTES_FILE=./routes.json
LOG_LEVEL=INFO

# Enterprise WeChat group bot webhook (optional)
WECOM_WEBHOOK=

# DingTalk custom bot webhook (optional)
DINGTALK_WEBHOOK=
# Only needed when DingTalk bot security uses "加签"
DINGTALK_SECRET=
DINGTALK_KEYWORD=DT

# Telegram BotFather token and destination group/channel chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional extra public X accounts. Leave blank to monitor/push only X_ACCOUNTS.
X_EXTRA_ACCOUNTS_FILE=
X_PUBLIC_FEED_DB=./data/x-public-feed.sqlite
