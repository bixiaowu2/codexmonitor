[Unit]
Description=Meme Radar read-only multi-chain monitor
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10
[Service]
Type=simple
User=meme-radar
Group=meme-radar
WorkingDirectory=/opt/meme-radar
EnvironmentFile=/etc/meme-radar.env
EnvironmentFile=-/etc/gmgn-readonly.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/meme-radar/cloud.py
Restart=always
RestartSec=30
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/meme-radar
MemoryMax=768M
CPUQuota=100%
[Install]
WantedBy=multi-user.target
