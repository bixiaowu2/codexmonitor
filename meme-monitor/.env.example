MEME_DATA=/var/lib/meme-radar
MEME_CHAINS=bsc,solana,robinhood,xlayer,arc,stable
MEME_INTERVAL_SECONDS=60
MEME_MAX_CANDIDATES=40
MEME_HTTP_TIMEOUT_SECONDS=10
MEME_TELEGRAM_ENABLED=false
MEME_TELEGRAM_BOT_TOKEN=
MEME_TELEGRAM_CHAT_ID=
MEME_DINGTALK_ENABLED=false
MEME_DINGTALK_WEBHOOK=
MEME_DINGTALK_SECRET=
MEME_DINGTALK_KEYWORD=DT
MEME_SMART_WALLETS_FILE=/var/lib/meme-radar/smart_wallets.json
MEME_KOL_EVENTS_FILE=/var/lib/meme-radar/kol_events.jsonl
MEME_X_FEED_FILE=/var/lib/meme-radar/x_mentions.jsonl
MEME_EXTRA_SOURCES_FILE=/var/lib/meme-radar/extra_sources.json
MEME_SAFETY_ENABLED=true
MEME_SAFETY_MAX_CHECKS=12
MEME_SAFETY_CACHE_SECONDS=900
BSC_RPC_URL=https://bsc-dataseed.binance.org
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional read-only public post bridge written by x-monitor
MEME_X_PUBLIC_FEED_DB=

# Optional GMGN official read-only API. Never add a private/signing key here.
# The systemd unit loads /etc/gmgn-readonly.env as root. Keep that file mode 0600.
GMGN_HTTP_TIMEOUT_SECONDS=10
GMGN_MAX_CHECKS=1

# Optional JSONL hand-off from Binance Web3 Skills (query-token-info,
# query-token-audit, crypto-market-rank, trading-signal, meme-rush).  Each
# line must contain chain, exact address, provider beginning with binance, and
# checked_at.  Evidence is read-only context and never overrides safety gates.
MEME_BINANCE_WEB3_EVIDENCE_FILE=
MEME_BINANCE_WEB3_MAX_AGE=1800
# Live public Binance Web3 info/audit is opt-in until endpoint access is
# verified on the server. It is bounded and query-only.
MEME_BINANCE_WEB3_LIVE_ENABLED=false
MEME_BINANCE_WEB3_LIVE_CHECKS=4
