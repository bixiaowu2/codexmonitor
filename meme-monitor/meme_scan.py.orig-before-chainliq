DT_INTERVAL = 21600
DT_BUFFER_MAX = 30
_DT_STATE = DATA / 'dt_digest.json'


def _dt_load():
    try:
        return json.loads(_DT_STATE.read_text())
    except Exception:
        return {}


def _dt_save(d):
    try:
        _DT_STATE.write_text(json.dumps(d))
    except Exception:
        pass
